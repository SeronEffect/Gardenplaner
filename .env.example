# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://garden:change-me@localhost:5432/garden
# Public URL of the production build (used by the CSRF check). Read at BUILD time:
# change it → rebuild (`pnpm build` or `docker compose up -d --build`). Default: http://localhost:3000
# ORIGIN=http://localhost:3000
